# =====================================================================
# MEDICUS Platform - Environment Configuration Template
# Copy this file to .env and configure keys as needed for production.
# =====================================================================

# 1. Google Gemini & Vertex AI Configuration (Optional)
# When set, the system uses official Google Gemini 3.8 Flash via the google-genai SDK.
# If unset, the system transparently activates the grounded local telemetry engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1
VERTEX_AI_LOCATION=us-central1

# 2. Authentication & Cryptography
# Secret key used for signing JWT authentication tokens. Set a random 32+ character string in production.
MEDICUS_JWT_SECRET=medicus-secure-jwt-secret-key-2026-public-health-grid

# 3. Google Cloud BigQuery & Storage (Optional Cloud Integrations)
BIGQUERY_PROJECT=
BIGQUERY_DATASET=swasthya_grid_telemetry

# 4. Local Database & Server Port
PORT=8000
SWASTHYA_DB_PATH=data/swasthya_grid.db
DEMO_MODE=true

# 5. Google Maps Platform (Optional in .env; can also be input directly in the UI)
# Enables real-time Google Maps satellite/terrain visualization for 208 primary health facilities.
VITE_GOOGLE_MAPS_API_KEY=
